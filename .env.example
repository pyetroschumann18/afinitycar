# Chave privada "sb_secret_..." do projeto Supabase eelpnvdufxlwyotmxkhn.
# Configurar somente no servidor/Vercel. Nunca usar NEXT_PUBLIC_ nem commitar o valor.
SUPABASE_SECRET_KEY=


# Meta Pixel (ID do Pixel, visível no navegador) e token da API de Conversões (secreto, só servidor)
NEXT_PUBLIC_META_PIXEL_ID=SEU_PIXEL_ID
META_CONVERSIONS_API_TOKEN=SEU_TOKEN_DA_API_DE_CONVERSOES
# Opcional: código da aba "Testar eventos" do Gerenciador de Eventos (remover em produção)
# META_TEST_EVENT_CODE=TEST12345
